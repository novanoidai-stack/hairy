# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
# `.env` esta en .gitignore: NUNCA se versiona. Este fichero solo lleva nombres.

# --- App (build de Expo) ---------------------------------------------------
# Publicas por diseno: estan pensadas para vivir en el cliente, y de hecho van
# incrustadas en el codigo como fallback (lib/supabase.ts, web/assets/*.js).
#
# Desde el 28 ago 2026 aqui va la PUBLISHABLE (`sb_publishable_...`, 46
# caracteres), NO la anon heredada (el JWT que empieza por `eyJ`). La heredada
# esta desactivada / en vias de desactivarse: no se podia rotar, asi que la
# unica cura para la fuga era sustituirla. Ver decision 9 de CLAUDE.md.
#
# El nombre sigue diciendo ANON a proposito: es el que esta dado de alta en
# Vercel y lo leen tanto el build de Expo como scripts/seo/data.mjs.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Scripts de mantenimiento (service_role) -------------------------------
# LA LLAVE MAESTRA. Se salta TODAS las RLS: con ella se leen y se escriben los
# datos de TODOS los salones, sin que ninguna politica lo impida. No es "una
# credencial mas".
#
# El 28 ago 2026 se encontraron cinco ficheros VERSIONADOS con estas claves en
# claro, en un repositorio PUBLICO, y la de produccion seguia siendo valida.
# Se sacaron del codigo y se rotaron. Sacarlas del codigo NO basta: siguen en
# el historial de git, que es publico, asi que la unica cura es rotar.
#
# Nunca la pegues en un fichero .ts/.mjs, ni en un chat, ni en un issue.
# Solo aqui, en tu .env, que esta en .gitignore.
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto DISTINTO (novanoidai.com). Variable aparte a proposito: si se
# comparte el nombre, tarde o temprano alguien apunta la clave de un proyecto
# al otro. Solo la usan scripts/update-profile.ts y seed-data.mjs, que en
# realidad no pintan nada en este repo (candidatos a borrar).
SUPABASE_SERVICE_ROLE_KEY_NOVANOIDAI=

# --- Capa de IA ------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Tests E2E (Playwright) ------------------------------------------------
# Cuenta con la que tests/auth.setup.ts entra al software para los specs
# autenticados (agenda, caja, config, equipo, inventario, recursos).
#
# Hasta el 27 ago 2026 estas dos estaban EN CLARO dentro de tests/auth.setup.ts
# y por tanto quedaron en el historial de git. Si esa cuenta sigue siendo la
# personal de alguien, hay que rotar la contrasena: sacarla del codigo no la
# borra del historial.
#
# Recomendado: una cuenta de pruebas dedicada, no la personal de nadie.
# En CI se definen como secrets del repositorio, no en este fichero.
E2E_EMAIL=
E2E_PASSWORD=
