{
  "imports": {
    "@/": "./",
    "react-native": "./tools/deno-shims/reactNative.js",
    "react-native-url-polyfill/auto": "./tools/deno-shims/urlPolyfillAuto.js",
    "@/lib/supabase": "./tools/deno-shims/supabaseClient.js"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env --sloppy-imports --no-check lib/",
    "test:ia": "deno test --no-config --allow-net supabase/functions/shared/openrouterClient.test.ts",
    "verificar:modelos": "node scripts/verificar-modelos.mjs",
    "check:edges": "deno check --no-config supabase/functions/vigilar-agenda/index.ts supabase/functions/agenda-optimizador/index.ts supabase/functions/agenda-asistente/index.ts"
  },
  "exclude": [
    "node_modules/",
    "ui-references/",
    "web/",
    ".expo/",
    "supabase/functions/",
    "lib/chispaOps.test.ts"
  ],
  "comments": {
    "exclude": "supabase/functions/ se excluye porque sus imports relativos ../../../lib/*.ts requieren resolución bundler; validarlas con `deno task check:edges` (--no-config ignora este exclude)"
  }
}
