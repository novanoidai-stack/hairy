{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.web.tsx",
    "lib/**/*.web.ts",
    "lib/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}"
  ],
  "ignore": [
    "app/app/**",
    "types/database.types.ts"
  ],
  "ignoreDependencies": ["zustand"],
  "ignoreBinaries": ["ffmpeg"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
